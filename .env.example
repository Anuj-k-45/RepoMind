# ============================================================
# RepoMind — Environment Configuration Example
# Copy this file to .env and configure your local values.
# Never commit .env or real credentials to Git.
# ============================================================

APP_ENV=development
LOG_LEVEL=INFO

# ------------------------------------------------------------
# LLM / Groq
# ------------------------------------------------------------
GROQ_API_KEY=replace_with_your_groq_api_key
CHAT_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------
POSTGRES_DSN=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5433/auth-project-db
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD

# ------------------------------------------------------------
# Neo4j
# ------------------------------------------------------------
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD

# ------------------------------------------------------------
# Qdrant
# ------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=repomind_chunks

# ------------------------------------------------------------
# GitHub
# Required for private repositories and/or authenticated API access.
# ------------------------------------------------------------
GITHUB_TOKEN=replace_with_your_github_token
ALLOW_PUBLIC_REPOSITORIES=true

# ------------------------------------------------------------
# Repository authorization
# Keep both allowlists aligned if your application uses both.
# Use comma-separated owner/repository names without extra spaces.
# ------------------------------------------------------------
REPOMIND_ALLOWED_REPOSITORIES=LableOrg/java-maven-junit-helloworld,Anuj-k-45/QuickBite-AI
AUTHORIZED_REPOSITORIES=LableOrg/java-maven-junit-helloworld,Anuj-k-45/QuickBite-AI

DEFAULT_REPOSITORY=LableOrg/java-maven-junit-helloworld
REPOMIND_UI_USER_ID=local-streamlit-user

# ------------------------------------------------------------
# Embeddings
# Must match the model used during ingestion.
# BAAI/bge-small-en-v1.5 produces 384-dimensional embeddings.
# ------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32
MAX_EMBEDDING_BATCH_SIZE=64

# ------------------------------------------------------------
# Ingestion / Chunking
# ------------------------------------------------------------
CHUNK_MAX_TOKENS=450
CHUNK_OVERLAP_LINES=8
MAX_FILE_BYTES=1500000
MAX_FILES=50000

# ------------------------------------------------------------
# CodeAnalyzer-Java
# Install the canjv CLI separately and ensure it is on PATH.
# ------------------------------------------------------------
CANJV_COMMAND=canjv
ANALYZER_TIMEOUT_SECONDS=900
ANALYZER_GRAPH_DEPTH=6
ANALYZER_MAX_GRAPH_NODES=200000

# ------------------------------------------------------------
# Retrieval
# ------------------------------------------------------------
MAX_RESULTS=8
MAX_GRAPH_HOPS=3
MAX_RETRIEVAL_ROUNDS=3
REQUEST_TIMEOUT_SECONDS=12

# ------------------------------------------------------------
# LLM context / GitHub source fetching
# Confirm these variable names are read by your application.
# ------------------------------------------------------------
REPOMIND_LLM_MAX_TOKENS=1800
REPOMIND_SOURCE_FETCH_TIMEOUT_SECONDS=8
REPOMIND_SOURCE_FETCH_WORKERS=6

# ------------------------------------------------------------
# Optional FastAPI configuration
# Only needed if you still run the API separately from Streamlit.
# ------------------------------------------------------------
REPOMIND_API_KEY=
API_HOST=127.0.0.1
API_PORT=8000